{
  "name": "the-flame-tool",
  "version": "0.1.0",
  "private": true,
  "description": "The Flame Tool — high-school problem solver for web and Mac",
  "author": "Ozzee Marguth",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mac:dev": "node electron/dev-runner.cjs",
    "mac:prepare": "npm run build && node scripts/prepare-standalone.cjs",
    "mac:build": "npm run mac:prepare && electron-builder --mac --universal"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.flametool.app",
    "productName": "The Flame Tool",
    "copyright": "Copyright © Ozzee Marguth",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/resources/*.md"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "electron/resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "The Flame Tool does not use the camera.",
        "NSMicrophoneUsageDescription": "The Flame Tool does not use the microphone.",
        "NSDesktopCaptureUsageDescription": "The Flame Tool captures your screen once when you click Analyze so it can read a schoolwork problem."
      }
    },
    "dmg": {
      "title": "The Flame Tool"
    }
  }
}
