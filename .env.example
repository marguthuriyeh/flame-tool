# Preferred: free Gemini API key from https://aistudio.google.com/apikey
# Leave blank to use demo mode.
GEMINI_API_KEY=

# Optional. Default: gemini-2.5-flash-lite (fast free-tier vision model)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. Default: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional OpenAI fallback — used only when no Gemini key is set.
OPENAI_API_KEY=

# Optional. Must be a vision-capable chat model. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional. OpenAI-compatible base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
